{
  "www.youtube.com": {
    "errors": {
      "genericError": {
        "trigger": {
          "selector": "#player-error-message-container",
          "parent": "#content #error-screen"
        },
        "actions": [{}]
      },
      "adblockEnforcementOverlay": {
        "trigger": {
          "selector": "ytd-enforcement-message-view-model",
          "parent": "ytd-app ytd-popup-container"
        },
        "actions": [
          {
            "shouldRefresh": true
          },
          {
            "delay": 6000,
            "elementsToClick": ["ytd-enforcement-message-view-model #dismiss-button"],
            "elementsToRemove": ["ytd-enforcement-message-view-model", "tp-yt-iron-overlay-backdrop"],
            "shouldAutoplay": true
          }
        ]
      },
      "adblockEnforcementWall": {
        "trigger": {
          "selector": "ytd-enforcement-message-view-model",
          "parent": "#player"
        },
        "actions": [
          {
            "shouldRefresh": true
          }
        ]
      },
      "experiencingInterruptions": {
        "trigger": {
          "selector": "tp-yt-paper-toast:not([aria-hidden]):has(a[href*='3037019'], a[href*='check_ad_blocker'])",
          "parent": "ytd-popup-container"
        },
        "actions": [{}]
      }
    }
  },
  "aternos.org": {
    "errors": {
      "adblockEnforcementOverlay": {
        "trigger": {
          "selector": "i.fa-sad-tear",
          "parent": "div[style*='z-index']:has(i.fa-sad-tear)"
        },
        "actions": [
          {
            "elementsToClick": ["i.fa-sad-tear"]
          }
        ]
      }
    }
  },
  "samfw.com": {
