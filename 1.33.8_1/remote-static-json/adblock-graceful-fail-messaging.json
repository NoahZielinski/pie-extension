            "header": "(b)Ad News",
            "ctaText": "Learn more",
            "ctaLink": "https://help.pie.org",
            "messageDelay": 3600000
          }
        ]
      }
    },
    "unpauseSettings": {
      "unpauseAfter": 1725043280,
      "unpauseVersion": "1.0.1"
    },
    "popoverMessage": {
      "header": "Bad news",
      "message": "It looks like this site is blocking adblockers today."
    }
  },
